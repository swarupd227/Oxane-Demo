# Copy to .env to override the defaults in docker-compose.yml.
WEB_PORT=5180
API_PORT=8010
DB_PORT=5546
POSTGRES_PASSWORD=oxane_dev

# replay: recorded responses only, no network. record: call the model and save. live: call the model.
LLM_MODE=replay

# Needed only to record a run. Replay works without any key.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# For Claude on Microsoft Foundry, set LLM_PROVIDER=foundry and these two instead.
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=

# New deals: uploads and live AI need this code (sent as X-Demo-Access-Code). Unset turns them off.
DEMO_ACCESS_CODE=
# Daily cap on live model spend for new deals, in US$.
LIVE_DAILY_CAP_USD=10

# Settings › AI provider (Administrator): encrypts a key saved there. A Fernet key, made with
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Unset, the screen shows that a key can't be saved. Saving locally also writes ANTHROPIC_API_KEY here.
SETTINGS_ENCRYPTION_KEY=
