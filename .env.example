# Copy to .env to override the defaults in docker-compose.yml.
WEB_PORT=5180
API_PORT=8010
DB_PORT=5546
POSTGRES_PASSWORD=oxane_dev

# replay: recorded responses only, no network. record: call the model and save. live: call the model.
LLM_MODE=replay

# Needed only to record a run. Replay works without any key.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# For Claude on Microsoft Foundry, set LLM_PROVIDER=foundry and these two instead.
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=
